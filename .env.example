# Example environment variables for QuickCalAI.
# Copy this file to apps/server/.env (and/or root .env) and fill in real values.
# Never commit .env files — they are gitignored.

# Required for local dev and production.
BETTER_AUTH_SECRET=<generate-a-64-char-random-string>

# The API/auth origin (the server Worker). It is the JWT issuer and the
# Google/Stripe callback base. Do not point this at the web origin unless the
# API is mounted on the same host.
# Local dev: http://localhost:3000
# Production (split origins): https://api.quickcalai.com
# Production (same origin):  https://quickcalai.com
BETTER_AUTH_URL=http://localhost:3000

# The web origin (the Astro Worker). Comma-separate multiple origins.
# Local dev: http://localhost:4321
# Production: https://quickcalai.com (add https://www.quickcalai.com if used)
CORS_ORIGIN=http://localhost:4321

# Optional custom-domain wiring for Alchemy. The zone must already be active
# in the Cloudflare account. Leave blank for the workers.dev deployment.
# Example: WEB_CUSTOM_DOMAIN=quickcalai.com
WEB_CUSTOM_DOMAIN=
# Example: SERVER_CUSTOM_DOMAIN=api.quickcalai.com
SERVER_CUSTOM_DOMAIN=

# Optional: override the API base baked into the web bundle. Defaults to the
# server Worker URL; set it to the custom API origin when using one.
# Example: PUBLIC_SERVER_URL=https://api.quickcalai.com
PUBLIC_SERVER_URL=

# Stripe — required for subscriptions/billing. Leave blank to deploy without
# billing; the app returns a clear configuration error if checkout is used.
# Webhook endpoint: <BETTER_AUTH_URL>/api/auth/stripe/webhook
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional fallback price IDs. If left blank, run the /admin sync to create them.
STRIPE_PREMIUM_PRICE_ID=
STRIPE_PREMIUM_ANNUAL_PRICE_ID=

# Workers AI model for event extraction (in-network; leave empty for the default).
EXTRACTION_MODEL=

# Resend — required for email delivery of .ics files and auth emails.
# Leave blank to deploy without email; auth still works, reset emails report a
# configuration error until a key is set.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="QuickCalAI <noreply@yourdomain.com>"

# Sent.dm — required for SMS delivery of .ics files. Leave blank to disable SMS.
SENT_DM_API_KEY=

# Google OAuth — required for "Sign in with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_IOS_CLIENT_ID=

# Better-Auth admin plugin — comma-separated Better-Auth user IDs that should
# be admins (not Clerk IDs).
ADMIN_USER_IDS=
