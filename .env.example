# Example environment variables for QuickCalAI.
# Copy this file to apps/server/.env (and/or root .env) and fill in real values.
# Never commit .env files — they are gitignored.

# Required for local dev and production.
BETTER_AUTH_SECRET=<generate-a-64-char-random-string>

# Production: https://quickcalai.com (your custom domain).
# Local dev: leave unset; Alchemy injects the local server URL.
BETTER_AUTH_URL=https://quickcalai.com

# Production: https://quickcalai.com.
# Local dev: http://localhost:4321
CORS_ORIGIN=https://quickcalai.com

# Stripe — required for subscriptions/billing. Use test keys for dev, live keys for prod.
# Webhook endpoint: https://quickcalai.com/api/auth/stripe/webhook
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional fallback price IDs. If left blank, run the /admin sync to create them.
STRIPE_PREMIUM_PRICE_ID=
STRIPE_PREMIUM_ANNUAL_PRICE_ID=

# Google Gemini — required for AI schedule extraction.
GOOGLE_GENERATIVE_AI_API_KEY=

# Resend — required for email delivery of .ics files.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="QuickCalAI <noreply@yourdomain.com>"

# Sent.dm — required for SMS delivery of .ics files.
SENT_DM_API_KEY=

# Google OAuth — required for "Sign in with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_IOS_CLIENT_ID=

# Better-Auth admin plugin — comma-separated user IDs that should be admins.
ADMIN_USER_IDS=
