# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=http://localhost:3000

# @type=url
CORS_ORIGIN=http://localhost:4321

# @type=string(minLength=1)
STRIPE_SECRET_KEY=

# @type=string(minLength=1)
STRIPE_WEBHOOK_SECRET=

# Monthly premium price (price_...) from the Stripe dashboard.
# @type=string(minLength=1)
STRIPE_PREMIUM_PRICE_ID=

# Annual premium price (price_...). Optional.
# @required=false @type=string(minLength=1)
STRIPE_PREMIUM_ANNUAL_PRICE_ID=

# GLM-OCR (z.ai) — reads images/PDFs into markdown (the OCR step).
# Optional: pasted-text ingestion works without it; image/PDF uploads fail
# with a clear "OCR provider not configured" until it's set.
# @required=false @type=string(minLength=1)
ZAI_API_KEY=

# Optional override — point at an adapter exposing the same
# POST layout_parsing contract (e.g. a self-hosted GLM-OCR).
# @required=false @type=url
ZAI_LAYOUT_PARSING_URL=

# Workers AI model used for event extraction (in-network, no API key).
# @required=false @type=string(minLength=1)
EXTRACTION_MODEL=

# Resend API key for outgoing email.
# @type=string(minLength=1)
RESEND_API_KEY=

# Sender identity, e.g. "QuickCalAI <noreply@extractions.quickcalai.com>".
# @required=false @type=string(minLength=1)
RESEND_FROM_EMAIL=

# Sent.dm API key for outgoing SMS.
# @type=string(minLength=1)
SENT_DM_API_KEY=

# Google OAuth credentials for social sign-in.
# @required=false @type=string(minLength=1)
GOOGLE_CLIENT_ID=

# @required=false @type=string(minLength=1)
GOOGLE_CLIENT_SECRET=

# @required=false @type=string(minLength=1)
GOOGLE_IOS_CLIENT_ID=

# Comma-separated list of user IDs that should be granted admin access.
# @required=false @type=string(minLength=1)
ADMIN_USER_IDS=
