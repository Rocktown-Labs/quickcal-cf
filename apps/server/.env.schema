# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
STRIPE_SECRET_KEY=

# @type=string(minLength=1)
STRIPE_WEBHOOK_SECRET=

# Monthly premium price (price_...) from the Stripe dashboard.
# @type=string(minLength=1)
STRIPE_PREMIUM_PRICE_ID=

# Annual premium price (price_...). Optional.
# @required=false @type=string(minLength=1)
STRIPE_PREMIUM_ANNUAL_PRICE_ID=

# Gemini API key for calendar extraction.
# @type=string(minLength=1)
GOOGLE_GENERATIVE_AI_API_KEY=

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @dynamic @required=false @type=string(minLength=1)
AXIOM_API_KEY=

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @dynamic @required=false @type=string(minLength=1)
AXIOM_DATASET=

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @dynamic @required=false @type=url
AXIOM_EDGE_URL=
