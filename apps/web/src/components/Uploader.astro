---
---
<div id="uploader" class="w-full font-sans">
  <!-- Loading / auth gate -->
  <div data-state="checking" class="rounded-2xl border border-border bg-card p-10 text-center text-sm text-muted-foreground">
    Loading uploader…
  </div>

  <!-- Initial -->
  <div data-state="idle" class="hidden w-full space-y-6">
    <div class="mb-6 text-center md:text-left flex flex-col md:flex-row md:items-end md:justify-between gap-4">
      <div>
        <div class="flex items-center justify-center md:justify-start space-x-2 mb-2">
          <h2 class="font-bold text-2xl">AI Calendar Extraction</h2>
          <div data-premium-badge class="hidden items-center space-x-1 bg-gradient-to-r from-yellow-400 to-orange-500 text-white px-3 py-1 rounded-full text-xs font-bold shadow-lg">
            <span>PREMIUM</span>
          </div>
        </div>
        <p class="text-muted-foreground text-base max-w-md">Upload an image or PDF with dates and times to extract calendar events instantly</p>
      </div>
      <div class="flex w-fit mx-auto md:mx-0 bg-card p-1 rounded-xl border border-border">
        <button data-tab="ai" class="flex items-center space-x-2 px-4 py-2 rounded-lg text-sm font-bold transition-all whitespace-nowrap bg-primary text-primary-foreground shadow-md">
          <span>⚡</span><span>AI Upload</span>
        </button>
        <button data-tab="text" class="flex items-center space-x-2 px-4 py-2 rounded-lg text-sm font-bold transition-all whitespace-nowrap text-muted-foreground hover:text-foreground">
          <span>📋</span><span>Paste Text</span>
        </button>
        <button data-tab="manual" class="flex items-center space-x-2 px-4 py-2 rounded-lg text-sm font-bold transition-all whitespace-nowrap text-muted-foreground hover:text-foreground">
          <span>✏️</span><span>Manual</span>
        </button>
      </div>
    </div>

    <!-- AI tab -->
    <div data-panel="ai">
      <div data-dropzone class="hidden relative border-2 border-dashed rounded-2xl p-10 text-center transition-all duration-500 w-full border-border hover:border-primary/40 bg-card">
        <input data-file-input type="file" accept="image/*,application/pdf" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" />
        <div class="space-y-4 pointer-events-none">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl">📤</div>
          <div>
            <p class="text-xl font-bold">Drop your document here</p>
            <p class="text-muted-foreground text-base mt-2">or click to browse files</p>
          </div>
          <p class="text-sm text-muted-foreground font-medium pt-4">Supports JPEG, PNG, WebP, and PDF up to 10MB</p>
        </div>
      </div>
      <div data-url-row class="hidden mt-3 flex gap-2">
        <input data-url-input type="url" placeholder="…or paste an image / PDF / text file URL (https)" class="flex-1 px-4 bg-input border border-input rounded-lg h-10 text-base focus:outline-none focus:border-primary" />
        <button data-url-submit class="shrink-0 bg-primary hover:bg-primary/90 text-primary-foreground rounded-lg px-5 h-10 text-sm font-bold disabled:opacity-50">Fetch</button>
      </div>
      <p data-free-note class="hidden mt-3 text-center text-sm text-muted-foreground">
        🎁 <strong class="text-foreground">1 free AI extraction</strong> left — no credit card needed. Premium unlocks unlimited.
      </p>
      <div data-premium-gate class="hidden text-center py-12 bg-card rounded-2xl border border-border">
        <div class="text-5xl mx-auto mb-4">👑</div>
        <h3 class="text-xl font-bold mb-2">You've used your free AI extraction</h3>
        <p class="text-muted-foreground mb-6 text-base">Upgrade to Premium for unlimited AI extraction from images, PDFs, text, and URLs.</p>
        <a href="/settings#subscription" class="inline-block bg-primary hover:bg-primary/90 text-primary-foreground text-lg px-8 py-4 rounded-xl shadow-lg transition-all font-bold">Upgrade to Premium</a>
      </div>
    </div>

    <!-- Paste text tab -->
    <div data-panel="text" class="hidden bg-card rounded-2xl border border-border p-6 space-y-4">
      <p class="text-sm text-muted-foreground">Paste a schedule as plain text, Markdown, or CSV — the AI reads dates and times straight from it. Same thing an API agent sends to <code class="text-foreground">POST /api/uploads/text</code>.</p>
      <div class="space-y-2">
        <label class="text-sm font-semibold ml-1" for="text-title">Title (optional)</label>
        <input id="text-title" placeholder="Fall class schedule" class="w-full px-4 bg-input border border-input rounded-lg h-10 text-base focus:outline-none focus:border-primary" />
      </div>
      <div class="space-y-2">
        <label class="text-sm font-semibold ml-1" for="text-content">Schedule text</label>
        <textarea id="text-content" placeholder={"Mon 10/5: Biology 101 at 9:00 AM in Room 214\nTue 10/6: Study group 3-5pm @ library\n…"} class="w-full px-4 py-3 bg-input border border-input rounded-xl focus:outline-none focus:border-primary resize-none text-base h-40 font-mono text-sm"></textarea>
      </div>
      <div data-text-gate class="hidden text-center py-8">
        <div class="text-4xl mx-auto mb-3">👑</div>
        <p class="text-muted-foreground">AI extraction is a Premium feature — <a href="/settings#subscription" class="text-primary font-semibold">upgrade here</a>. (First extraction is free.)</p>
      </div>
      <button data-text-submit class="w-full bg-primary hover:bg-primary/90 text-primary-foreground h-12 rounded-xl text-lg font-bold transition-all shadow-lg disabled:opacity-50">⚡ Extract Events from Text</button>
      <p data-text-error class="hidden text-sm text-danger"></p>
    </div>

    <!-- Manual tab -->
    <div data-panel="manual" class="hidden bg-card rounded-2xl border border-border p-6 space-y-4">
      <div data-tz-note class="hidden p-3 bg-primary/10 border border-primary/30 rounded-xl text-sm">
        Events will be created in: <strong class="text-primary" data-tz></strong>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="col-span-2 md:col-span-1 space-y-2">
          <label class="text-sm font-semibold ml-1" for="manual-title">Event Title *</label>
          <input id="manual-title" placeholder="Meeting with John" class="w-full px-4 bg-input border border-input rounded-lg h-10 text-base focus:outline-none focus:border-primary" />
        </div>
        <div class="col-span-1 space-y-2">
          <label class="text-sm font-semibold ml-1" for="manual-date">Date *</label>
          <input id="manual-date" type="date" class="w-full px-4 bg-input border border-input rounded-lg h-10 text-base focus:outline-none focus:border-primary" />
        </div>
        <div class="col-span-1 space-y-2">
          <label class="text-sm font-semibold ml-1" for="manual-time">Time (optional)</label>
          <input id="manual-time" type="time" step="60" class="w-full px-4 bg-input border border-input rounded-lg h-10 text-base focus:outline-none focus:border-primary" />
        </div>
        <div class="col-span-1 space-y-2">
          <label class="text-sm font-semibold ml-1" for="manual-end">End time (optional)</label>
          <input id="manual-end" type="time" step="60" class="w-full px-4 bg-input border border-input rounded-lg h-10 text-base focus:outline-none focus:border-primary" />
        </div>
        <div class="col-span-1 space-y-2">
          <label class="text-sm font-semibold ml-1" for="manual-location">Location (optional)</label>
          <input id="manual-location" placeholder="Room 214" class="w-full px-4 bg-input border border-input rounded-lg h-10 text-base focus:outline-none focus:border-primary" />
        </div>
        <div class="col-span-2 space-y-2">
          <label class="text-sm font-semibold ml-1" for="manual-desc">Description</label>
          <textarea id="manual-desc" placeholder="Event details..." class="w-full px-4 py-3 bg-input border border-input rounded-xl focus:outline-none focus:border-primary resize-none text-base h-24"></textarea>
        </div>
      </div>
      <button data-manual-add class="w-full border border-input hover:bg-accent hover:text-accent-foreground rounded-xl h-10 text-sm font-bold">＋ Add to list</button>
      <div data-manual-list class="space-y-2"></div>
      <button data-manual-submit class="w-full bg-primary hover:bg-primary/90 text-primary-foreground h-12 rounded-xl text-lg font-bold transition-all shadow-lg disabled:opacity-50">📅 Create <span data-manual-count>0</span> Calendar Event<span data-manual-plural>s</span></button>
      <p data-manual-error class="hidden text-sm text-danger"></p>
      <p class="text-xs text-muted-foreground text-center">Free — no AI involved. The .ics is ready instantly.</p>
    </div>
  </div>

  <!-- Processing -->
  <div data-state="processing" class="hidden flex-col w-full">
    <h2 class="text-xl font-bold mb-4">AI extracts details instantly</h2>
    <div class="w-full bg-card p-4 rounded-xl border border-border mb-4 flex items-center gap-4 shadow-lg">
      <div class="w-10 h-10 bg-primary rounded-lg flex items-center justify-center shrink-0 text-lg">🖼</div>
      <div class="flex-1 min-w-0">
        <div class="text-sm font-semibold truncate" data-file-name></div>
        <div class="text-xs text-muted-foreground">Processing with AI…</div>
      </div>
      <div class="animate-pulse text-primary">◌</div>
    </div>
    <div class="w-full bg-primary text-primary-foreground p-3 rounded-xl flex items-center justify-center gap-2 mb-4 shadow-[0_4px_20px_rgba(194,51,38,0.3)]">
      <span class="animate-pulse">⚡</span>
      <span class="text-sm font-bold">AI Processing in Progress</span>
    </div>
    <div class="w-full mb-4">
      <div class="flex justify-between mb-1 px-1">
        <span class="text-xs text-muted-foreground">Processing…</span>
        <span class="text-xs font-semibold text-primary" data-progress-pct>25%</span>
      </div>
      <div class="w-full h-1.5 bg-muted rounded-full overflow-hidden">
        <div class="h-full bg-primary rounded-full transition-all duration-500 ease-out" data-progress-bar style="width: 25%"></div>
      </div>
    </div>
    <div class="w-full flex flex-col gap-2 mb-4" data-steps></div>
    <div class="w-full bg-card p-6 rounded-xl text-center border border-border shadow-lg">
      <div class="text-6xl font-black text-primary leading-none animate-pulse">…</div>
      <div class="text-sm font-medium text-muted-foreground mt-2">Events Detected</div>
    </div>
  </div>

  <!-- Failed / no events -->
  <div data-state="error" class="hidden flex-col w-full">
    <div class="w-full bg-card p-6 rounded-2xl border border-border text-center shadow-lg">
      <div class="text-5xl mx-auto mb-4">⚠️</div>
      <h2 class="text-xl font-bold mb-2" data-error-title></h2>
      <p class="text-muted-foreground text-base max-w-md mx-auto mb-6" data-error-message></p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <button data-reset class="bg-primary hover:bg-primary/90 text-primary-foreground rounded-xl px-4 py-3 text-sm font-bold">↻ Try another file</button>
        <a href="/dashboard" class="border border-input bg-card hover:bg-accent hover:text-accent-foreground rounded-xl px-4 py-3 text-sm font-bold">View files</a>
      </div>
    </div>
  </div>

  <!-- Completed -->
  <div data-state="complete" class="hidden flex-col w-full">
    <h2 class="text-xl font-bold mb-4">Download your .ics and you're done</h2>
    <div class="w-full bg-success/10 p-4 rounded-xl border border-success/30 mb-4 flex items-center gap-4 shadow-lg">
      <div class="w-10 h-10 bg-success text-background rounded-lg flex items-center justify-center shrink-0 text-lg">✓</div>
      <div>
        <div class="text-lg font-bold text-success">Processing Complete!</div>
        <div class="text-base"><span data-event-count></span> events ready to download</div>
      </div>
    </div>
    <div class="w-full grid grid-cols-1 md:grid-cols-2 gap-3">
      <button data-action="download" class="flex items-center gap-3 p-4 rounded-xl transition-all duration-300 hover:-translate-y-1 text-left bg-primary text-primary-foreground shadow-[0_10px_25px_rgba(194,51,38,0.3)] hover:bg-primary/90">
        <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0 bg-white/15 text-lg">📥</div>
        <div class="flex-1"><div class="text-base font-bold">Download .ics File</div><div class="text-sm text-primary-foreground/80">Import to any calendar app</div></div>
      </button>
      <button data-action="copy" class="flex items-center gap-3 p-4 rounded-xl transition-all duration-300 hover:-translate-y-1 text-left bg-card border border-border hover:border-primary/40">
        <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0 bg-muted text-lg">📋</div>
        <div class="flex-1"><div class="text-base font-bold">Copy Link</div><div class="text-sm text-muted-foreground">Paste into email or chat</div></div>
      </button>
      <button data-action="share" class="flex items-center gap-3 p-4 rounded-xl transition-all duration-300 hover:-translate-y-1 text-left bg-card border border-border hover:border-primary/40">
        <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0 bg-muted text-lg">🔗</div>
        <div class="flex-1"><div class="text-base font-bold">Share Link</div><div class="text-sm text-muted-foreground">Use your device share sheet</div></div>
      </button>
      <button data-action="delivery" class="flex items-center gap-3 p-4 rounded-xl transition-all duration-300 hover:-translate-y-1 text-left bg-card border border-border hover:border-primary/40">
        <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0 bg-muted text-lg">✉️</div>
        <div class="flex-1"><div class="text-base font-bold">Email or SMS</div><div class="text-sm text-muted-foreground" data-delivery-hint>Send file directly</div></div>
      </button>
    </div>
    <div data-delivery-form class="hidden w-full mt-3 bg-card p-4 rounded-xl border border-border">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <div class="flex flex-col gap-1.5">
          <label class="text-sm font-medium" for="delivery-email">Email</label>
          <input id="delivery-email" type="email" placeholder="you@example.com" class="px-4 bg-input border border-input rounded-lg h-10 focus:outline-none focus:border-primary" />
          <button data-send-email class="mt-1 bg-primary hover:bg-primary/90 text-primary-foreground rounded-lg h-10 font-bold disabled:opacity-50">Send Email</button>
        </div>
        <div class="flex flex-col gap-1.5">
          <label class="text-sm font-medium" for="delivery-phone">Phone Number</label>
          <input id="delivery-phone" type="tel" placeholder="+1 (555) 123-4567" class="px-4 bg-input border border-input rounded-lg h-10 focus:outline-none focus:border-primary" />
          <button data-send-sms class="mt-1 bg-primary hover:bg-primary/90 text-primary-foreground rounded-lg h-10 font-bold disabled:opacity-50">Send SMS</button>
        </div>
      </div>
      <p data-delivery-status class="hidden mt-3 text-sm"></p>
    </div>
    <div class="w-full mt-6 bg-card p-4 rounded-xl border border-border flex items-center gap-4 shadow-lg">
      <div class="w-10 h-10 bg-primary rounded-lg flex items-center justify-center shrink-0 text-lg">📅</div>
      <div class="flex-1 min-w-0">
        <div class="text-base font-semibold truncate" data-result-name></div>
        <div class="text-sm text-muted-foreground"><span data-event-count></span> events • Ready to import</div>
      </div>
      <button data-action="review" class="px-4 py-2 bg-muted rounded-lg border border-input hover:bg-accent hover:text-accent-foreground transition-all text-sm shrink-0">Review &amp; edit events</button>
      <button data-action="copy" class="px-4 py-2 bg-muted rounded-lg border border-input hover:bg-accent hover:text-accent-foreground transition-all text-sm shrink-0">Copy Link</button>
    </div>
    <div class="pt-6 text-center w-full">
      <button data-reset class="text-muted-foreground hover:text-foreground text-sm">Upload another file</button>
    </div>
  </div>
</div>

<script>
  import { authClient } from "../lib/auth-client";
  import { api, ApiError } from "../lib/api";

  const root = document.getElementById("uploader")!;
  const $ = <T extends Element = Element>(sel: string): T | null => root.querySelector(sel);
  const $$ = <T extends Element = Element>(sel: string): T[] =>
    Array.from(root.querySelectorAll(sel)) as T[];

  const STEPS = ["Analyzing image", "Detecting dates & times", "Extracting event details", "Formatting calendar data"];

  let isPremium = false;
  let freeCredits = 0;
  let pollTimer: number | null = null;
  let stepTimer: number | null = null;
  let stepIndex = 0;
  let fileName = "";
  let uploadId: string | null = null;
  let shareToken: string | null = null;
  let downloadPath: string | null = null;
  let eventCount = 0;
  const manualRows: Array<{ title: string; date: string; time: string; endTime: string; location: string; description: string }> = [];

  function show(state: string) {
    for (const el of $$("[data-state]")) {
      const match = el.getAttribute("data-state") === state;
      el.classList.toggle("hidden", !match);
      if (match && (state === "processing" || state === "error" || state === "complete")) {
        el.classList.add("flex");
      } else {
        el.classList.remove("flex");
      }
    }
  }

  function toast(message: string, ok = true) {
    const el = document.createElement("div");
    el.textContent = message;
    el.className = `fixed bottom-6 left-1/2 -translate-x-1/2 z-50 px-4 py-2.5 rounded-xl text-sm font-semibold shadow-xl ${ok ? "bg-success text-background" : "bg-danger text-white"}`;
    document.body.appendChild(el);
    setTimeout(() => el.remove(), 3500);
  }

  function setTab(tab: "ai" | "text" | "manual") {
    for (const btn of $$("[data-tab]")) {
      const active = btn.getAttribute("data-tab") === tab;
      btn.className = `flex items-center space-x-2 px-4 py-2 rounded-lg text-sm font-bold transition-all whitespace-nowrap ${active ? "bg-primary text-primary-foreground shadow-md" : "text-muted-foreground hover:text-foreground"}`;
    }
    $('[data-panel="ai"]')?.classList.toggle("hidden", tab !== "ai");
    $('[data-panel="text"]')?.classList.toggle("hidden", tab !== "text");
    $('[data-panel="manual"]')?.classList.toggle("hidden", tab !== "manual");
  }

  function renderSteps() {
    const container = $('[data-steps]');
    if (!container) return;
    container.innerHTML = STEPS.map((label, i) => {
      const done = i < stepIndex;
      const current = i === stepIndex;
      return `<div class="flex items-center gap-3 p-3 rounded-xl transition-all duration-300 ${current ? "bg-primary/10 border border-primary/30" : "border border-transparent"}">
        <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0 text-sm ${done ? "bg-success text-background" : current ? "bg-primary" : "bg-muted"}">${done ? "✓" : "•"}</div>
        <span class="text-sm ${done || current ? "text-foreground font-semibold" : "text-muted-foreground"}">${label}</span>
        ${current ? '<div class="ml-auto text-primary animate-spin">◌</div>' : ""}
        ${done ? '<span class="ml-auto text-xs font-medium text-success">✓ Complete</span>' : ""}
      </div>`;
    }).join("");
    const pct = Math.min(Math.round(((stepIndex + 1) / STEPS.length) * 100), 99);
    const bar = $("[data-progress-bar]") as HTMLElement | null;
    if (bar) bar.style.width = `${pct}%`;
    const pctEl = $("[data-progress-pct]");
    if (pctEl) pctEl.textContent = `${pct}%`;
  }

  function stopTimers() {
    if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
    if (stepTimer) { clearInterval(stepTimer); stepTimer = null; }
  }

  function reset() {
    stopTimers();
    uploadId = shareToken = downloadPath = null;
    eventCount = 0;
    stepIndex = 0;
    fileName = "";
    manualRows.length = 0;
    renderManualList();
    const input = $("[data-file-input]") as HTMLInputElement | null;
    if (input) input.value = "";
    const urlInput = qs("[data-url-input]") as HTMLInputElement | null;
    if (urlInput) urlInput.value = "";
    $('[data-delivery-form]')?.classList.add("hidden");
    const hint = $("[data-delivery-hint]");
    if (hint) hint.textContent = "Send file directly";
    show("idle");
  }

  async function startUpload(file: File) {
    if (!file.type.startsWith("image/") && file.type !== "application/pdf") {
      toast("Please upload an image or PDF.", false);
      return;
    }
    fileName = file.name;
    await runIngestion(() => api.createUpload(file));
  }

  async function startUrlUpload() {
    const input = qs("[data-url-input]") as HTMLInputElement | null;
    const url = input?.value.trim() ?? "";
    if (!url || !/^https:\/\//i.test(url)) {
      toast("Paste an https:// URL to an image, PDF, or text file.", false);
      return;
    }
    let host = url;
    try { host = new URL(url).hostname; } catch { /* validated below */ }
    fileName = host;
    const nameEl = $("[data-file-name]");
    if (nameEl) nameEl.textContent = url;
    await runIngestion(() => api.createUploadFromUrl(url));
  }

  async function startTextUpload() {
    const content = (qs("#text-content") as HTMLTextAreaElement)?.value ?? "";
    const title = (qs("#text-title") as HTMLInputElement)?.value.trim() ?? "";
    if (!content.trim()) {
      toast("Paste some schedule text first.", false);
      return;
    }
    fileName = title || "Pasted text";
    const nameEl = $("[data-file-name]");
    if (nameEl) nameEl.textContent = fileName;
    await runIngestion(() => api.createUploadFromText(content, title || undefined));
  }

  /**
   * Shared processing flow for every AI ingestion (file, URL, text):
   * show the stepper, start the workflow, poll until terminal.
   */
  async function runIngestion(start: () => Promise<{ runId: string }>) {
    stepIndex = 0;
    renderSteps();
    show("processing");
    try {
      const { runId } = await start();
      stepTimer = window.setInterval(() => {
        if (stepIndex < STEPS.length - 1) { stepIndex += 1; renderSteps(); }
      }, 3000);
      pollTimer = window.setInterval(async () => {
        try {
          const status = await api.uploadStatusByRun(runId);
          if (status.status === "completed" || status.status === "no_events" || status.status === "failed") {
            stopTimers();
            finish(status);
          }
        } catch (err) {
          stopTimers();
          showError("Status check failed", err instanceof Error ? err.message : "Please try again.");
        }
      }, 2000);
    } catch (err) {
      showError("Upload failed", err instanceof Error ? err.message : "Please try again.");
      // A free credit may have been refused — refresh the banner state.
      void api.me().then((me) => { freeCredits = me.freeCredits; }).catch(() => undefined);
    }
  }

  function finish(status: { status: string; eventCount: number; failureReason: string | null; uploadId: string; result: { shareToken?: string; downloadPath?: string } | null }) {
    if (status.status === "completed" && status.result) {
      uploadId = status.uploadId;
      eventCount = status.eventCount;
      shareToken = status.result.shareToken ?? null;
      downloadPath = status.result.downloadPath ?? null;
      for (const el of $$("[data-event-count]")) el.textContent = String(eventCount);
      const nameEl = $("[data-result-name]");
      if (nameEl) nameEl.textContent = `${fileName.replace(/\.[^/.]+$/, "") || "calendar-events"}-events.ics`;
      show("complete");
      toast(`Done. Extracted ${eventCount} event${eventCount === 1 ? "" : "s"}.`);
    } else if (status.status === "no_events") {
      showError("No calendar events found", status.failureReason ?? "That file looked valid, but QuickCalAI could not find any dates or times to turn into events.");
    } else {
      showError("Processing failed", status.failureReason ?? "QuickCalAI could not finish processing this upload.");
    }
  }

  function showError(title: string, message: string) {
    const t = $("[data-error-title]");
    const m = $("[data-error-message]");
    if (t) t.textContent = title;
    if (m) m.textContent = message;
    show("error");
  }

  function shareUrl(): string | null {
    return shareToken ? `${window.location.origin}/s/${shareToken}` : null;
  }

  async function downloadIcs() {
    if (!downloadPath) { toast("The calendar file is not ready yet.", false); return; }
    const res = await fetch(`${api.serverUrl()}${downloadPath}`, { credentials: "include" });
    if (!res.ok) { toast("Download failed.", false); return; }
    const blob = await res.blob();
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = url;
    link.download = `${fileName.replace(/\.[^/.]+$/, "") || "calendar-events"}.ics`;
    document.body.appendChild(link);
    link.click();
    link.remove();
    URL.revokeObjectURL(url);
  }

  async function copyLink() {
    const url = shareUrl();
    if (!url) { toast("The share link is not ready yet.", false); return; }
    try {
      await navigator.clipboard.writeText(url);
      toast("Share link copied.");
    } catch {
      toast("Could not copy the share link.", false);
    }
  }

  async function deviceShare() {
    const url = shareUrl();
    if (!url) { toast("The share link is not ready yet.", false); return; }
    try {
      const nav = navigator as Navigator & { share?: (data: { title?: string; text?: string; url?: string }) => Promise<void> };
      if (nav.share) {
        await nav.share({ title: "QuickCalAI Schedule", text: "Check out this calendar schedule:", url });
        return;
      }
      await copyLink();
    } catch (err) {
      if (err instanceof DOMException && err.name === "AbortError") return;
      toast("Could not share the calendar link.", false);
    }
  }

  function setDeliveryStatus(message: string, ok: boolean) {
    const el = $("[data-delivery-status]");
    if (!el) return;
    el.textContent = message;
    el.className = `mt-3 text-sm ${ok ? "text-success" : "text-danger"}`;
    el.classList.remove("hidden");
  }

  // Wire up static controls
  for (const btn of $$("[data-tab]")) {
    btn.addEventListener("click", () => setTab(btn.getAttribute("data-tab") as "ai" | "text" | "manual"));
  }
  for (const btn of $$("[data-reset]")) {
    btn.addEventListener("click", reset);
  }
  qs("[data-url-submit]")?.addEventListener("click", () => void startUrlUpload());
  qs("[data-text-submit]")?.addEventListener("click", () => void startTextUpload());

  const dropzone = $("[data-dropzone]");
  const fileInput = $('[data-file-input]') as HTMLInputElement | null;
  dropzone?.addEventListener("dragover", (e) => { e.preventDefault(); dropzone.classList.add("border-primary", "scale-[1.02]"); });
  dropzone?.addEventListener("dragleave", () => dropzone.classList.remove("border-primary", "scale-[1.02]"));
  dropzone?.addEventListener("drop", (e) => {
    e.preventDefault();
    const de = e as DragEvent;
    dropzone.classList.remove("border-primary", "scale-[1.02]");
    const file = de.dataTransfer?.files?.[0];
    if (file) void startUpload(file);
  });
  fileInput?.addEventListener("change", () => {
    const file = fileInput.files?.[0];
    if (file) void startUpload(file);
  });

  for (const btn of $$('[data-action]')) {
    btn.addEventListener("click", () => {
      const action = btn.getAttribute("data-action");
      if (action === "download") void downloadIcs();
      else if (action === "copy") void copyLink();
      else if (action === "share") void deviceShare();
      else if (action === "review") {
        window.location.href = uploadId ? `/files#${uploadId}` : "/files";
      }
      else if (action === "delivery") {
        const form = $("[data-delivery-form]");
        form?.classList.toggle("hidden");
        const hint = $("[data-delivery-hint]");
        if (hint) hint.textContent = form?.classList.contains("hidden") ? "Send file directly" : "Hide delivery options";
        if (form && !form.classList.contains("hidden")) {
          void api.me().then((me) => {
            if (me.email && !((qs("#delivery-email") as HTMLInputElement).value)) (qs("#delivery-email") as HTMLInputElement).value = me.email;
            if (me.phoneNumber && !((qs("#delivery-phone") as HTMLInputElement).value)) (qs("#delivery-phone") as HTMLInputElement).value = me.phoneNumber;
          }).catch(() => undefined);
        }
      }
    });
  }

  function qs(sel: string): Element | null { return root.querySelector(sel); }

  $('[data-send-email]')?.addEventListener("click", async () => {
    const input = qs("#delivery-email") as HTMLInputElement | null;
    const email = input?.value.trim() ?? "";
    if (!uploadId) { toast("Upload ID not found.", false); return; }
    if (!email) { toast("Please enter an email address.", false); return; }
    try {
      const res = await api.emailUpload(uploadId, email);
      setDeliveryStatus(res.message, true);
    } catch (err) {
      setDeliveryStatus(err instanceof Error ? err.message : "Failed to send email.", false);
    }
  });

  $('[data-send-sms]')?.addEventListener("click", async () => {
    const input = qs("#delivery-phone") as HTMLInputElement | null;
    const phone = input?.value.trim() ?? "";
    if (!uploadId) { toast("Upload ID not found.", false); return; }
    if (!phone) { toast("Please enter a phone number.", false); return; }
    try {
      const res = await api.smsUpload(uploadId, phone);
      setDeliveryStatus(res.message, true);
    } catch (err) {
      setDeliveryStatus(err instanceof Error ? err.message : "Failed to send SMS.", false);
    }
  });

  // ── Manual multi-event builder (free, no AI) ────────────────────────────

  function renderManualList() {
    const list = qs("[data-manual-list]");
    const count = qs("[data-manual-count]") as HTMLElement | null;
    const plural = qs("[data-manual-plural]") as HTMLElement | null;
    if (count) count.textContent = String(manualRows.length);
    if (plural) plural.style.display = manualRows.length === 1 ? "none" : "inline";
    if (!list) return;
    list.innerHTML = manualRows.map((row, i) => `
      <div class="flex items-center gap-3 rounded-lg border border-border bg-background px-4 py-2.5">
        <div class="min-w-0 flex-1">
          <p class="text-sm font-semibold truncate">${row.title.replace(/</g, "&lt;")}</p>
          <p class="text-xs text-muted-foreground">${row.date}${row.time ? ` · ${row.time}` : ""}${row.endTime ? `–${row.endTime}` : ""}${row.location ? ` · ${row.location}` : ""}</p>
        </div>
        <button data-remove-row="${i}" class="shrink-0 text-xs font-bold text-danger border border-danger/40 rounded-lg px-2.5 py-1">Remove</button>
      </div>`).join("");
    for (const btn of list.querySelectorAll("[data-remove-row]")) {
      btn.addEventListener("click", () => {
        manualRows.splice(Number(btn.getAttribute("data-remove-row")), 1);
        renderManualList();
      });
    }
  }

  function readManualForm() {
    return {
      title: (qs("#manual-title") as HTMLInputElement)?.value.trim() ?? "",
      date: (qs("#manual-date") as HTMLInputElement)?.value ?? "",
      time: (qs("#manual-time") as HTMLInputElement)?.value ?? "",
      endTime: (qs("#manual-end") as HTMLInputElement)?.value ?? "",
      location: (qs("#manual-location") as HTMLInputElement)?.value.trim() ?? "",
      description: (qs("#manual-desc") as HTMLTextAreaElement)?.value.trim() ?? "",
    };
  }

  function clearManualForm() {
    for (const id of ["#manual-title", "#manual-date", "#manual-time", "#manual-end", "#manual-location", "#manual-desc"]) {
      const el = qs(id) as HTMLInputElement | HTMLTextAreaElement | null;
      if (el) el.value = "";
    }
  }

  qs("[data-manual-add]")?.addEventListener("click", () => {
    const errEl = $("[data-manual-error]");
    errEl?.classList.add("hidden");
    const row = readManualForm();
    if (!row.title || !row.date) {
      if (errEl) { errEl.textContent = "Fill in at least title and date, then add to the list."; errEl.classList.remove("hidden"); }
      return;
    }
    manualRows.push(row);
    clearManualForm();
    renderManualList();
  });

  $('[data-manual-submit]')?.addEventListener("click", async () => {
    const errEl = $("[data-manual-error]");
    errEl?.classList.add("hidden");

    // If the form has a fresh row, pull it in first.
    const current = readManualForm();
    if (current.title && current.date) {
      manualRows.push(current);
      clearManualForm();
    }

    if (manualRows.length === 0) {
      if (errEl) { errEl.textContent = "Add at least one event (title + date)."; errEl.classList.remove("hidden"); }
      return;
    }

    try {
      const data = await api.createDirectEvents(manualRows);
      manualRows.length = 0;
      renderManualList();
      fileName = `manual-events`;
      uploadId = data.uploadId;
      eventCount = data.eventCount;
      shareToken = data.shareToken;
      downloadPath = data.downloadPath;
      for (const el of $$("[data-event-count]")) el.textContent = String(eventCount);
      const nameEl = $("[data-result-name]");
      if (nameEl) nameEl.textContent = `${eventCount} manual event${eventCount === 1 ? "" : "s"}-events.ics`;
      show("complete");
      toast(`Created ${eventCount} event${eventCount === 1 ? "" : "s"} — review them on the Files page.`);
    } catch (err) {
      if (errEl) {
        errEl.textContent = err instanceof ApiError ? err.message : "Failed to create events.";
        errEl.classList.remove("hidden");
      }
    }
  });

  // Init: require session, load premium + free-credit state
  (async () => {
    try {
      const { data: session } = await authClient.getSession();
      if (!session?.user) { window.location.href = "/login"; return; }
      const me = await api.me();
      isPremium = me.isPremium;
      freeCredits = me.freeCredits;
      const canIngest = isPremium || freeCredits > 0;
      if (isPremium) {
        root.querySelector("[data-premium-badge]")?.classList.remove("hidden");
        root.querySelector("[data-premium-badge]")?.classList.add("flex");
      }
      if (canIngest) {
        $('[data-dropzone]')?.classList.remove("hidden");
        $('[data-url-row]')?.classList.remove("hidden");
        if (!isPremium && freeCredits > 0) {
          const note = qs("[data-free-note]");
          if (note) {
            note.innerHTML = `🎁 <strong class="text-foreground">${freeCredits} free AI extraction${freeCredits === 1 ? "" : "s"}</strong> left — no credit card needed. Premium unlocks unlimited.`;
            note.classList.remove("hidden");
          }
        }
      } else {
        $('[data-premium-gate]')?.classList.remove("hidden");
      }
      if (!canIngest) {
        qs("[data-text-gate]")?.classList.remove("hidden");
        (qs("[data-text-submit]") as HTMLButtonElement | null)?.setAttribute("disabled", "true");
      }
      const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
      const tzNote = $("[data-tz-note]");
      const tzEl = $("[data-tz]");
      if (tz && tzNote && tzEl) { tzEl.textContent = tz; tzNote.classList.remove("hidden"); }
      renderManualList();
      setTab("ai");
      show("idle");
    } catch {
      window.location.href = "/login";
    }
  })();
</script>
