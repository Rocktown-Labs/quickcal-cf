  <script>
    // Tab switcher in hero demo card
    const heroTabs = document.getElementById("hero-tabs");
    if (heroTabs) {
      const tabButtons = heroTabs.querySelectorAll<HTMLButtonElement>("[data-hero-tab]");
      const panels = {
        visual: document.getElementById("panel-visual"),
        text: document.getElementById("panel-text"),
        agent: document.getElementById("panel-agent"),
      };

      tabButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const target = btn.getAttribute("data-hero-tab") as keyof typeof panels;
          tabButtons.forEach((b) => {
            b.classList.remove("bg-primary", "text-primary-foreground", "active");
            b.classList.add("text-muted-foreground");
          });
          btn.classList.add("bg-primary", "text-primary-foreground", "active");
          btn.classList.remove("text-muted-foreground");

          Object.entries(panels).forEach(([key, panel]) => {
            if (panel) {
              panel.classList.toggle("hidden", key !== target);
            }
          });
        });
      });
    }

    // Intersection observer for scroll-triggered reveals
    if (typeof IntersectionObserver !== "undefined") {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("in-view");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
      );

      for (const el of document.querySelectorAll(".reveal")) {
        observer.observe(el);
      }
    } else {
      for (const el of document.querySelectorAll(".reveal")) {
        el.classList.add("in-view");
      }
    }
  </script>
