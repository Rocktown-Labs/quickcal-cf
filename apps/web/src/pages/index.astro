---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Logo from "../components/Logo.astro";

const stats = [
  { value: "10,000+", label: "Events extracted" },
  { value: "500+", label: "Active users" },
  { value: "99.2%", label: "Extraction accuracy" },
  { value: "<3s", label: "Average processing" },
] as const;

const steps = [
  {
    number: "01",
    title: "Upload any schedule",
    body: "Drag in a screenshot, PDF, event flyer, or a photo of a whiteboard. We accept any image or document with dates.",
  },
  {
    number: "02",
    title: "AI reads every event",
    body: "Gemini identifies dates, times, locations, and event names. You can review and edit the results before exporting.",
  },
  {
    number: "03",
    title: "Export or share",
    body: "Download an .ics file, send it by email or SMS, or share a public link. Your calendar stays in sync wherever you need it.",
  },
] as const;

const features = [
  {
    title: "Smart upload",
    body: "Screenshots, photos of whiteboards, PDFs, scanned papers — if it has dates, we can read it.",
    icon: "upload",
  },
  {
    title: "AI extraction",
    body: "Every date, time, location, and event name is pulled out and converted into structured calendar data.",
    icon: "sparkles",
  },
  {
    title: "Editable results",
    body: "Review events in a clean table. Fix titles, adjust times, or remove rows before generating the file.",
    icon: "checklist",
  },
  {
    title: "Universal export",
    body: "Generate .ics files that import directly into Google Calendar, Apple Calendar, Outlook, and any calendar app.",
    icon: "calendar",
  },
  {
    title: "Email & SMS delivery",
    body: "Send calendar files straight to your inbox or phone. Share a schedule with a team in seconds.",
    icon: "send",
  },
  {
    title: "Private by default",
    body: "Your uploads are processed securely and deleted automatically. We only keep what we need, when we need it.",
    icon: "shield",
  },
] as const;

const plans = [
  {
    name: "Free",
    price: "$0",
    period: "",
    description: "Build calendars by hand",
    featured: false,
    features: [
      "Manual event creation",
      "Unlimited .ics downloads",
      "No credit card required",
    ],
  },
  {
    name: "Premium",
    price: "$12.99",
    period: "/mo",
    description: "AI extraction on demand",
    featured: true,
    features: [
      "Unlimited AI extractions",
      "Email & SMS delivery",
      "Public share links",
      "All calendar integrations",
      "Cancel anytime",
    ],
  },
  {
    name: "Annual",
    price: "$5.99",
    period: "/mo",
    description: "$71.88 billed annually · Save 54%",
    featured: false,
    features: [
      "Everything in Premium",
      "2 months free",
      "Priority processing",
      "White-label options",
    ],
  },
] as const;

const testimonials = [
  {
    name: "Sarah Chen",
    role: "Product Manager",
    content:
      "QuickCalAI turned a 12-page conference agenda into a calendar I could actually use. It took under a minute.",
  },
  {
    name: "Marcus Rodriguez",
    role: "Entrepreneur",
    content:
      "I used to miss event times buried in screenshots. Now I just upload and the event is in my calendar.",
  },
  {
    name: "Emily Watson",
    role: "Executive Assistant",
    content:
      "I process dozens of scheduling requests every week. This has cut the busywork down by at least half.",
  },
] as const;

const faqs = [
  {
    question: "What file types can I upload?",
    answer:
      "PNG, JPG, HEIC, PDF, and most common image formats work. Screenshots, event flyers, scanned papers, and even photos of whiteboards are supported.",
  },
  {
    question: "Is there a free plan?",
    answer:
      "Yes. You can create single events and download .ics files for free. AI-powered extraction from images and PDFs requires a Premium plan.",
  },
  {
    question: "How accurate is the AI extraction?",
    answer:
      "QuickCalAI currently extracts events with a 99.2% accuracy rate on structured schedules. You can also review and edit every event before exporting.",
  },
  {
    question: "Which calendar apps work with the .ics files?",
    answer:
      "Any app that supports the iCalendar format — Google Calendar, Apple Calendar, Outlook, Fantastical, Notion, and many more.",
  },
  {
    question: "Is my data private?",
    answer:
      "Uploads are stored only long enough to process them, then removed automatically. We do not train on your content or share it with third parties.",
  },
] as const;

const currentYear = new Date().getFullYear();

function iconPath(name: string) {
  switch (name) {
    case "upload":
      return "M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4 M17 8l-5-5-5 5 M12 3v12";
    case "sparkles":
      return "M12 2l2.4 7.2h7.6l-6 4.8 2.4 7.2-6-4.8-6 4.8 2.4-7.2-6-4.8h7.6z";
    case "checklist":
      return "M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7 M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z";
    case "calendar":
      return "M8 2v4 M16 2v4 M3 10h18 M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z M9 16l2 2 4-4";
    case "send":
      return "M22 2L11 13 M22 2l-7 20-4-9-9-4 20-7z";
    case "shield":
      return "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z";
    default:
      return "";
  }
}
---

<Layout>
  <div class="relative overflow-hidden pb-16 md:pb-0">
    <Navbar />

    <!-- Hero -->
    <section id="hero" class="relative min-h-[92vh] flex items-center border-b border-border/40">
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-24 w-full">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div class="max-w-xl">
            <p class="eyebrow mb-6 reveal">AI calendar extraction</p>

            <h1 class="font-heading text-5xl sm:text-6xl md:text-7xl tracking-tight leading-[1.05] reveal reveal-delay-1">
              Image to<br />calendar,<span class="accent-text"> in seconds.</span>
            </h1>

            <p class="mt-7 text-lg text-muted-foreground leading-relaxed reveal reveal-delay-2">
              Upload any screenshot, PDF, or photo of a schedule. QuickCalAI extracts every event and builds an .ics file you can drop into Google Calendar, Apple Calendar, or Outlook.
            </p>

            <div class="mt-9 flex flex-col sm:flex-row gap-3 reveal reveal-delay-3">
              <a href="/signup" class="btn-solid group">
                Get started free
                <svg
                  class="ml-2 w-4 h-4 transition-transform group-hover:translate-x-0.5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </a>
              <a href="#how-it-works" class="btn-ghost">How it works</a>
            </div>

            <div class="mt-8 flex flex-wrap items-center gap-5 text-sm text-muted-foreground reveal reveal-delay-4">
              <span class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                No credit card required
              </span>
              <span class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                Free manual events
              </span>
            </div>
          </div>

          <div class="relative reveal reveal-delay-2">
            <div class="hero-frame rounded-lg overflow-hidden bg-card">
              <div class="absolute inset-x-0 top-0 h-px bg-primary/80"></div>
              <img
                src="/quickcalai-hero-image.png"
                alt="QuickCalAI dashboard showing an uploaded schedule and extracted calendar events"
                width="800"
                height="600"
                class="w-full h-auto"
                loading="eager"
              />
            </div>
            <p class="absolute -bottom-6 left-0 text-[10px] tracking-widest uppercase text-muted-foreground">
              Dashboard preview
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section class="border-b border-border/40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 divide-x divide-border/40">
          {stats.map(({ value, label }) => (
            <div class="py-10 px-4 text-center reveal">
              <div class="text-3xl md:text-4xl font-bold tracking-tight">{value}</div>
              <div class="mt-1 text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">
                {label}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Problem / promise -->
    <section class="py-28 border-b border-border/40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-12 items-start">
          <div class="reveal">
            <p class="eyebrow mb-4">The problem</p>
            <h2 class="font-heading text-4xl md:text-5xl tracking-tight leading-[1.08]">
              Schedules live everywhere<br />except your calendar.
            </h2>
          </div>
          <div class="md:pt-10 space-y-6 text-muted-foreground leading-relaxed reveal reveal-delay-1">
            <p>
              Class timetables arrive as PDFs. Conference agendas are hidden in screenshots. Shift rotors are pinned to a whiteboard. Re-typing them by hand is slow, tedious, and full of mistakes.
            </p>
            <p>
              QuickCalAI reads the document for you, turns the dates into structured events, and gives you a calendar file that just works.
            </p>
            <div class="pt-2">
              <a href="#features" class="text-sm font-semibold text-primary hover:underline">See the features</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section id="how-it-works" class="py-28">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-16 reveal">
          <p class="eyebrow mb-3">How it works</p>
          <h2 class="font-heading text-4xl md:text-5xl tracking-tight">Three steps to a usable calendar</h2>
        </div>

        <div class="grid md:grid-cols-3 gap-px bg-border/40 border border-border/40 rounded-lg overflow-hidden">
          {steps.map(({ number, title, body }, i) => (
            <div class="surface-subtle p-8 md:p-10 reveal" class:list={[`reveal-delay-${i + 1}`]}>
              <span class="text-5xl font-bold text-primary/30">{number}</span>
              <h3 class="mt-6 text-lg font-semibold">{title}</h3>
              <p class="mt-3 text-sm text-muted-foreground leading-relaxed">{body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Features -->
    <section id="features" class="py-28 border-t border-border/40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-16 max-w-2xl reveal">
          <div class="rule-red mb-6"></div>
          <h2 class="font-heading text-4xl md:text-5xl tracking-tight">Built for every kind of schedule</h2>
          <p class="mt-4 text-muted-foreground leading-relaxed">
            From a single meeting invite to a hundred-event semester plan, QuickCalAI handles the messy work so you don't have to.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-border/40 border border-border/40 rounded-lg overflow-hidden">
          {features.map(({ title, body, icon }, i) => (
            <div class="surface-subtle p-8 card-minimal reveal" class:list={[`reveal-delay-${(i % 3) + 1}`]}>
              <div class="w-10 h-10 rounded-md border border-primary/20 flex items-center justify-center text-primary mb-6">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d={iconPath(icon)} />
                </svg>
              </div>
              <h3 class="text-base font-semibold">{title}</h3>
              <p class="mt-2 text-sm text-muted-foreground leading-relaxed">{body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Pricing -->
    <section id="pricing" class="py-28 border-t border-border/40">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-14 max-w-xl mx-auto reveal">
          <p class="eyebrow mb-3">Pricing</p>
          <h2 class="font-heading text-4xl md:text-5xl tracking-tight">Simple, transparent plans</h2>
          <p class="mt-4 text-sm text-muted-foreground">Start free. Upgrade only when you want AI extraction.</p>
        </div>

        <div class="grid md:grid-cols-3 gap-6 items-start">
          {plans.map((plan) => (
            <div class="card-minimal rounded-xl p-7 relative reveal" class:list={{ featured: plan.featured }}>
              <div class="text-center pb-6 border-b border-border/40">
                {plan.featured && (
                  <span class="inline-block mb-4 px-2.5 py-1 text-[10px] font-bold tracking-widest uppercase rounded-full bg-primary text-primary-foreground">
                    Most popular
                  </span>
                )}
                <div class="text-base font-semibold">{plan.name}</div>
                <div class="mt-4">
                  <span class="text-4xl font-bold tracking-tight">{plan.price}</span>
                  {plan.period && <span class="text-muted-foreground text-sm">{plan.period}</span>}
                </div>
                <div class="text-xs text-muted-foreground mt-2">{plan.description}</div>
              </div>

              <ul class="space-y-3 my-6">
                {plan.features.map((feature) => (
                  <li class="flex items-start gap-3 text-sm">
                    <span class="mt-0.5 shrink-0 w-4 h-4 rounded-full border border-primary/40 flex items-center justify-center">
                      <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                    </span>
                    <span class="text-foreground/80">{feature}</span>
                  </li>
                ))}
              </ul>

              <a href="/signup" class:list={[
                "block w-full text-center text-sm rounded-md py-2.5 font-semibold transition-colors",
                plan.featured
                  ? "bg-primary text-primary-foreground hover:bg-primary/90"
                  : "border border-border hover:bg-secondary",
              ]}>
                Get started
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Testimonials -->
    <section id="testimonials" class="py-28 border-t border-border/40 bg-secondary/20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-14 max-w-xl reveal">
          <p class="eyebrow mb-3">Testimonials</p>
          <h2 class="font-heading text-4xl md:text-5xl tracking-tight">Loved by people who hate busywork</h2>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          {testimonials.map((t) => (
            <div class="card-minimal rounded-xl p-7 reveal">
              <div class="flex gap-1 mb-5 text-primary">
                {Array.from({ length: 5 }).map(() => (
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                  </svg>
                ))}
              </div>
              <p class="text-sm text-foreground/80 leading-relaxed mb-6">“{t.content}”</p>
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-full border border-border flex items-center justify-center">
                  <span class="text-[10px] font-bold text-primary">{t.name.split(" ").map((n) => n[0]).join("")}</span>
                </div>
                <div>
                  <p class="text-sm font-semibold">{t.name}</p>
                  <p class="text-xs text-muted-foreground">{t.role}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-28 border-t border-border/40">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-14 reveal">
          <p class="eyebrow mb-3">FAQ</p>
          <h2 class="font-heading text-4xl md:text-5xl tracking-tight">Questions, answered</h2>
        </div>

        <div class="divide-y divide-border/40 border-t border-b border-border/40">
          {faqs.map(({ question, answer }, i) => (
            <details class="group py-6 reveal" class:list={[`reveal-delay-${(i % 3) + 1}`]}>
              <summary class="flex items-center justify-between cursor-pointer">
                <span class="text-sm font-semibold pr-4">{question}</span>
                <span class="shrink-0 w-6 h-6 rounded-full border border-border flex items-center justify-center transition-transform group-open:rotate-45">
                  <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 5v14M5 12h14" />
                  </svg>
                </span>
              </summary>
              <p class="mt-4 text-sm text-muted-foreground leading-relaxed">{answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-28 border-t-2 border-primary bg-black">
      <div class="max-w-3xl mx-auto text-center px-4 sm:px-6 lg:px-8 reveal">
        <h2 class="font-heading text-4xl md:text-5xl tracking-tight text-white mb-4">
          Stop typing schedules by hand.
        </h2>
        <p class="text-base text-white/50 mb-9 max-w-lg mx-auto">
          Join the professionals who use QuickCalAI to turn screenshots and PDFs into real calendar events.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/signup" class="btn-white group">
            Get started free
            <svg class="ml-2 w-4 h-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
          <a href="#pricing" class="inline-flex items-center justify-center rounded-md border border-white/20 text-white hover:bg-white/5 h-11 px-7 text-sm font-semibold transition-colors">
            View pricing
          </a>
        </div>
        <p class="text-white/30 text-xs mt-6">Free to start · No credit card required · Cancel anytime</p>
      </div>
    </section>

    <!-- Footer -->
    <footer class="border-t border-border/50 bg-secondary/20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-5 gap-10 py-16">
          <div class="col-span-2 md:col-span-2">
            <div class="flex items-center gap-2.5 mb-5">
              <Logo size={24} className="text-primary" />
              <span class="text-base font-semibold tracking-tight">QuickCalAI</span>
            </div>
            <p class="text-sm text-muted-foreground leading-relaxed max-w-xs">
              AI-powered calendar extraction that saves you time and eliminates scheduling errors. Built by Rocktown Labs.
            </p>
          </div>
          <div>
            <h4 class="eyebrow mb-4">Product</h4>
            <ul class="space-y-3">
              <li><a href="#features" class="text-sm text-foreground/60 hover:text-foreground transition-colors">Features</a></li>
              <li><a href="#pricing" class="text-sm text-foreground/60 hover:text-foreground transition-colors">Pricing</a></li>
              <li><a href="/dashboard" class="text-sm text-foreground/60 hover:text-foreground transition-colors">Dashboard</a></li>
            </ul>
          </div>
          <div>
            <h4 class="eyebrow mb-4">Company</h4>
            <ul class="space-y-3">
              <li><a href="#hero" class="text-sm text-foreground/60 hover:text-foreground transition-colors">About</a></li>
              <li><a href="https://github.com/Rocktown-Labs/quickcalai" target="_blank" rel="noopener noreferrer" class="text-sm text-foreground/60 hover:text-foreground transition-colors">GitHub</a></li>
              <li><a href="mailto:support@quickcalai.com" class="text-sm text-foreground/60 hover:text-foreground transition-colors">Contact</a></li>
            </ul>
          </div>
          <div>
            <h4 class="eyebrow mb-4">Support</h4>
            <ul class="space-y-3">
              <li><a href="/help" class="text-sm text-foreground/60 hover:text-foreground transition-colors">Help &amp; Support</a></li>
              <li><a href="/privacy" class="text-sm text-foreground/60 hover:text-foreground transition-colors">Privacy</a></li>
              <li><a href="/terms" class="text-sm text-foreground/60 hover:text-foreground transition-colors">Terms</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-border/50 py-7 flex flex-col sm:flex-row justify-between items-center gap-4">
          <p class="text-xs text-muted-foreground">© {currentYear} QuickCalAI. All rights reserved.</p>
          <p class="text-xs text-muted-foreground/60">Built by Rocktown Labs</p>
        </div>
      </div>
    </footer>
  </div>

  <script>
    // Intersection observer for scroll-triggered reveals
    if (typeof IntersectionObserver !== "undefined") {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("in-view");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
      );

      for (const el of document.querySelectorAll(".reveal")) {
        observer.observe(el);
      }
    } else {
      for (const el of document.querySelectorAll(".reveal")) {
        el.classList.add("in-view");
      }
    }
  </script>
</Layout>
