---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Logo from "../components/Logo.astro";

const stats = [
  { value: "4 Ways In", label: "Photos, PDFs, text, or links" },
  { value: "Agent-Native", label: "Model Context Protocol (MCP)" },
  { value: "Review First", label: "Exact quotes and confidence scores" },
  { value: "$0 Forever", label: "Manual events and 1 free AI test" },
] as const;

const steps = [
  {
    number: "01",
    title: "Ingest any schedule",
    body: "Drag in a photo or syllabus PDF, paste raw schedule text, enter a public URL, or let Claude and Cursor push events directly via MCP.",
  },
  {
    number: "02",
    title: "AI extracts and verifies",
    body: "In-network AI identifies dates, times, titles, and locations. Every event includes the exact snippet from your document and a confidence score.",
  },
  {
    number: "03",
    title: "Sync everywhere",
    body: "Download universal .ics files, share private web links, or subscribe once to a personal calendar feed that stays updated automatically.",
  },
] as const;

const features = [
  {
    title: "Multi-modal input",
    body: "Photos of whiteboards, syllabi PDFs, pasted text, public URLs, or raw JSON. If it has schedule info, QuickCalAI can read it.",
    tag: "Flexible",
  },
  {
    title: "Agent-native with MCP",
    body: "Connect QuickCalAI to Claude, Cursor, or your autonomous agent via Model Context Protocol. Check status, review events, and rotate feeds.",
    tag: "Agent-Ready",
  },
  {
    title: "Review, do not guess",
    body: "Every extracted event displays its source quote and confidence score. Edit any field and your .ics file regenerates in real time.",
    tag: "Verification",
  },
  {
    title: "Subscribe-once feed",
    body: "Add your private webcal URL to Apple Calendar, Google Calendar, or Outlook. Every event you or your agents create syncs automatically.",
    tag: "Universal Sync",
  },
  {
    title: "Instant delivery",
    body: "Send calendar files straight to an email address or mobile phone. Share a tournament schedule with a team in seconds.",
    tag: "Sharing",
  },
  {
    title: "Private and durable",
    body: "Files are stored securely in your account and never used for model training. Durable workflows guarantee no uploads stay stuck in limbo.",
    tag: "Security",
  },
] as const;

const plans = [
  {
    name: "Free",
    price: "$0",
    period: "",
    description: "Manual events and first AI extraction",
    featured: false,
    features: [
      "1 one-time AI extraction",
      "Unlimited manual event creation",
      "Universal .ics downloads",
      "Public share links with revoke",
      "Calendar feed + REST/MCP access",
      "No credit card required",
    ],
  },
  {
    name: "Premium",
    price: "$12.99",
    period: "/mo",
    description: "Unlimited AI extraction on demand",
    featured: true,
    features: [
      "Everything in Free",
      "Unlimited AI extractions",
      "Email and SMS calendar delivery",
      "Cancel anytime",
    ],
  },
  {
    name: "Annual",
    price: "$5.99",
    period: "/mo",
    description: "$71.88 billed annually (Save 54%)",
    featured: false,
    features: [
      "Everything in Premium",
      "2 months free included",
      "Cancel anytime",
    ],
  },
] as const;

const useCases = [
  {
    role: "Students & Academics",
    headline: "Never retype a syllabus again",
    body: "Drop your multi-page course syllabus or exam timetable. Turn 30 lecture dates, assignment due dates, and office hours into a calendar in 5 seconds.",
    badge: "Syllabi & Timetables",
  },
  {
    role: "Executive Assistants",
    headline: "Turn messy agendas into clean calendar invites",
    body: "Itineraries arrive as screenshots, conference websites, and PDF attachments. QuickCalAI pulls every session with its exact room and time, ready to import.",
    badge: "Conferences & Travel",
  },
  {
    role: "Shift Workers & Team Leads",
    headline: "Share rotas with the entire crew in one tap",
    body: "Snap a photo of the weekly schedule pinned on the wall. Share a private link or SMS the .ics file directly so everyone stays on the same page.",
    badge: "Work Rotas & Leagues",
  },
] as const;

const faqs = [
  {
    question: "What formats can QuickCalAI process?",
    answer:
      "You can upload images (JPEG, PNG, WebP) and PDFs up to 10 MB, paste raw schedule text directly into the uploader, or provide a public URL. Developers and AI agents can also send structured JSON or call our MCP server.",
  },
  {
    question: "Is there a free trial?",
    answer:
      "Yes. Every new account gets 1 one-time AI extraction to test the full pipeline with no credit card required. You can also create events by hand, download .ics files, create share links, and use the calendar feed/REST/MCP for free forever. The AI credit is consumed when a run starts; a failed run does not restore it.",
  },
  {
    question: "How does the AI ensure accuracy?",
    answer:
      "QuickCalAI extracts events alongside confidence scores and the exact source quote from the original document. You can verify every single date and time before importing. If you edit an event, the .ics file updates immediately.",
  },
  {
    question: "How does the aggregate calendar feed work?",
    answer:
      "Instead of importing individual files, you can subscribe to your private calendar URL in Apple Calendar, Google Calendar, or Outlook. Whenever you or your AI agents process a new schedule, the events appear on your devices automatically.",
  },
  {
    question: "How do I connect Claude or Cursor?",
    answer:
      "QuickCalAI includes a native Model Context Protocol (MCP) server. Generate an API key in your Settings page, add the QuickCalAI MCP configuration to Claude Desktop or Cursor, and your agent can create events, inspect schedules, and manage calendars directly.",
  },
  {
    question: "Is my schedule data private?",
    answer:
      "Yes. Your documents and calendar events remain private to your account. We never use your data for AI training or sell it to third parties. If you create a share link, you can revoke it at any time, and deleting an upload purges the source file and events completely.",
  },
] as const;

const currentYear = new Date().getFullYear();
---

<Layout>
  <div class="relative overflow-hidden pb-16 md:pb-0">
    <Navbar />

    <!-- Hero Section -->
    <section id="hero" class="relative min-h-[92vh] flex items-center border-b border-border/40">
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-24 w-full">
        <div class="grid lg:grid-cols-12 gap-12 lg:gap-8 items-center">
          
          <!-- Left Column: Copy & CTAs -->
          <div class="lg:col-span-6 max-w-xl">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-primary/30 bg-primary/10 text-primary text-xs font-semibold uppercase tracking-wider mb-6 reveal">
              <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
              Agent-Ready Calendar Engine
            </div>

            <h1 class="font-heading text-5xl sm:text-6xl md:text-7xl tracking-tight leading-[1.05] reveal reveal-delay-1">
              From any schedule to your calendar,<br />
              <span class="accent-text italic">in seconds.</span>
            </h1>

            <p class="mt-7 text-lg text-muted-foreground leading-relaxed reveal reveal-delay-2">
              Drop a photo or PDF, paste schedule text, or connect Claude and Cursor. QuickCalAI turns messy dates into verified calendar events with exact source quotes and universal feeds.
            </p>

            <div class="mt-9 flex flex-col sm:flex-row gap-3 reveal reveal-delay-3">
              <a href="/signup" class="btn-solid group">
                Start free (1 AI extraction included)
                <svg
                  class="ml-2 w-4 h-4 transition-transform group-hover:translate-x-0.5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </a>
              <a href="#mcp-demo" class="btn-ghost">
                View MCP agent tools
              </a>
            </div>

            <div class="mt-8 flex flex-wrap items-center gap-5 text-xs font-medium text-muted-foreground reveal reveal-delay-4">
              <span class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                No credit card required
              </span>
              <span class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                Free manual events forever
              </span>
              <span class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                Universal .ics export
              </span>
            </div>
          </div>

          <!-- Right Column: Interactive Engine Showcase (Replaces static hero image) -->
          <div class="lg:col-span-6 reveal reveal-delay-2">
            <div class="hero-frame rounded-xl border border-border/70 bg-card overflow-hidden shadow-2xl">
              
              <!-- Window Chrome -->
              <div class="border-b border-border/50 bg-secondary/40 px-4 py-3 flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <div class="w-3 h-3 rounded-full bg-primary/80"></div>
                  <div class="w-3 h-3 rounded-full bg-muted-foreground/30"></div>
                  <div class="w-3 h-3 rounded-full bg-muted-foreground/30"></div>
                  <span class="ml-2 text-xs font-mono text-muted-foreground">quickcal-engine // live-demo</span>
                </div>
                
                <!-- Input Switcher Tabs -->
                <div class="flex items-center gap-1 bg-background/60 border border-border/60 rounded-lg p-0.5" id="hero-tabs">
                  <button type="button" data-hero-tab="visual" class="hero-tab-btn active px-2.5 py-1 text-xs font-medium rounded-md transition-colors bg-primary text-primary-foreground">
                    Photo / PDF
                  </button>
                  <button type="button" data-hero-tab="text" class="hero-tab-btn px-2.5 py-1 text-xs font-medium rounded-md transition-colors text-muted-foreground hover:text-foreground">
                    Pasted Text
                  </button>
                  <button type="button" data-hero-tab="agent" class="hero-tab-btn px-2.5 py-1 text-xs font-medium rounded-md transition-colors text-muted-foreground hover:text-foreground">
                    Agent (MCP)
                  </button>
                </div>
              </div>

              <!-- Tab Panel 1: Visual / Document Extraction -->
              <div id="panel-visual" class="hero-tab-panel p-5 space-y-4">
                <div class="rounded-lg border border-border/60 bg-secondary/20 p-3.5 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-md bg-primary/10 border border-primary/20 flex items-center justify-center text-primary font-mono text-xs font-bold">
                      PDF
                    </div>
                    <div>
                      <div class="text-sm font-semibold">CS101_Fall_Syllabus.pdf</div>
                      <div class="text-xs text-muted-foreground">3 pages · 24 dated sessions detected</div>
                    </div>
                  </div>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-primary/10 text-primary border border-primary/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                    Extracted in 1.4s
                  </span>
                </div>

                <!-- Verified Event Rows with Confidence & Quote -->
                <div class="space-y-2.5">
                  <div class="rounded-lg border border-border/50 bg-background/50 p-3 hover:border-primary/40 transition-colors">
                    <div class="flex items-start justify-between gap-2">
                      <div>
                        <div class="text-sm font-semibold flex items-center gap-2">
                          <span>Lecture: Algorithmic Complexity</span>
                          <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-secondary text-primary font-medium">99% confidence</span>
                        </div>
                        <div class="text-xs text-muted-foreground mt-0.5 font-mono">
                          Oct 26, 2026 · 10:00 AM to 11:30 AM · Hall B
                        </div>
                      </div>
                      <span class="text-[10px] uppercase font-mono px-2 py-0.5 rounded bg-primary/10 text-primary">MW Slot</span>
                    </div>
                    <div class="mt-2 text-[11px] text-muted-foreground/90 bg-secondary/30 px-2 py-1 rounded border border-border/30 font-mono">
                      Source: &quot;Mon/Wed 10:00-11:30am in Lecture Hall B&quot;
                    </div>
                  </div>

                  <div class="rounded-lg border border-border/50 bg-background/50 p-3 hover:border-primary/40 transition-colors">
                    <div class="flex items-start justify-between gap-2">
                      <div>
                        <div class="text-sm font-semibold flex items-center gap-2">
                          <span>Midterm Examination</span>
                          <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-secondary text-primary font-medium">98% confidence</span>
                        </div>
                        <div class="text-xs text-muted-foreground mt-0.5 font-mono">
                          Nov 4, 2026 · 1:00 PM to 3:00 PM · Science Center 102
                        </div>
                      </div>
                      <span class="text-[10px] uppercase font-mono px-2 py-0.5 rounded bg-primary/10 text-primary">Exam</span>
                    </div>
                    <div class="mt-2 text-[11px] text-muted-foreground/90 bg-secondary/30 px-2 py-1 rounded border border-border/30 font-mono">
                      Source: &quot;Midterm Exam: Wednesday Nov 4 at 1pm in SC 102&quot;
                    </div>
                  </div>
                </div>

                <!-- Live Result Actions -->
                <div class="pt-2 flex items-center justify-between border-t border-border/40 text-xs">
                  <div class="flex items-center gap-2">
                    <span class="font-mono text-muted-foreground">Universal Feed:</span>
                    <span class="font-mono text-foreground/80 bg-secondary px-2 py-0.5 rounded">webcal://.../feed</span>
                  </div>
                  <span class="font-semibold text-primary">Instant .ics ready</span>
                </div>
              </div>

              <!-- Tab Panel 2: Pasted Text -->
              <div id="panel-text" class="hero-tab-panel hidden p-5 space-y-4">
                <div class="rounded-lg border border-border/60 bg-secondary/20 p-3 font-mono text-xs text-muted-foreground leading-relaxed">
                  <span class="text-foreground font-semibold block mb-1">// Raw email pasted into QuickCalAI:</span>
                  &quot;Team offsite next Tuesday Oct 27 starting at 9:00 AM at Downtown Loft. Strategy review at 2:00 PM followed by team dinner at 6:30 PM.&quot;
                </div>

                <div class="space-y-2">
                  <div class="rounded-lg border border-border/50 bg-background/50 p-2.5 flex items-center justify-between">
                    <div>
                      <div class="text-xs font-semibold">Team Strategy Review</div>
                      <div class="text-[11px] text-muted-foreground font-mono">Oct 27, 2026 · 2:00 PM to 4:00 PM · Downtown Loft</div>
                    </div>
                    <span class="text-[10px] font-mono bg-primary/10 text-primary px-2 py-0.5 rounded">Parsed</span>
                  </div>
                  <div class="rounded-lg border border-border/50 bg-background/50 p-2.5 flex items-center justify-between">
                    <div>
                      <div class="text-xs font-semibold">Offsite Team Dinner</div>
                      <div class="text-[11px] text-muted-foreground font-mono">Oct 27, 2026 · 6:30 PM to 8:30 PM</div>
                    </div>
                    <span class="text-[10px] font-mono bg-primary/10 text-primary px-2 py-0.5 rounded">Parsed</span>
                  </div>
                </div>

                <div class="text-xs text-muted-foreground text-center">
                  Works with messy group chats, emails, and unformatted lists.
                </div>
              </div>

              <!-- Tab Panel 3: Agent & MCP -->
              <div id="panel-agent" class="hero-tab-panel hidden p-5 space-y-4">
                <div class="rounded-lg bg-black/90 p-3.5 font-mono text-xs text-muted-foreground border border-border/40">
                  <div class="text-primary font-bold mb-1.5">// Claude Desktop / Cursor MCP Config</div>
                  <div class="text-[#888888]">
                    &#123;<br />
                    &nbsp;&nbsp;&quot;mcpServers&quot;: &#123;<br />
                    &nbsp;&nbsp;&nbsp;&nbsp;&quot;quickcal&quot;: &#123;<br />
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&quot;url&quot;: &quot;https://quickcalai.com/mcp&quot;,<br />
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&quot;headers&quot;: &#123; &quot;Authorization&quot;: &quot;Bearer qc_live_...&quot; &#125;<br />
                    &nbsp;&nbsp;&nbsp;&nbsp;&#125;<br />
                    &nbsp;&nbsp;&#125;<br />
                    &#125;
                  </div>
                </div>

                <div class="rounded-lg border border-primary/30 bg-primary/5 p-3 flex items-start gap-2.5">
                  <span class="text-lg">🤖</span>
                  <div class="text-xs leading-relaxed text-foreground">
                    <strong class="text-primary">Agent workflow:</strong> Claude calls <code class="bg-secondary px-1 py-0.5 rounded font-mono">create_events</code>, checks status via <code class="bg-secondary px-1 py-0.5 rounded font-mono">get_status</code>, and hands you an aggregate calendar feed.
                  </div>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Compatibility Bar -->
    <section class="border-b border-border/40 py-8 bg-secondary/10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
          <div class="text-xs uppercase font-mono tracking-widest text-muted-foreground">
            Universal Sync &amp; Agent Protocol:
          </div>
          <div class="flex flex-wrap items-center justify-center gap-6 sm:gap-8 text-sm font-semibold text-foreground/75">
            <span class="flex items-center gap-1.5 hover:text-foreground transition-colors">
              <span class="text-primary">✦</span> Apple Calendar
            </span>
            <span class="flex items-center gap-1.5 hover:text-foreground transition-colors">
              <span class="text-primary">✦</span> Google Calendar
            </span>
            <span class="flex items-center gap-1.5 hover:text-foreground transition-colors">
              <span class="text-primary">✦</span> Microsoft Outlook
            </span>
            <span class="flex items-center gap-1.5 hover:text-foreground transition-colors">
              <span class="text-primary">✦</span> Claude Desktop
            </span>
            <span class="flex items-center gap-1.5 hover:text-foreground transition-colors">
              <span class="text-primary">✦</span> Cursor
            </span>
            <span class="flex items-center gap-1.5 hover:text-foreground transition-colors">
              <span class="text-primary">✦</span> Raycast
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- Metrics / Proof Points Bar -->
    <section class="border-b border-border/40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 lg:grid-cols-4 divide-y lg:divide-y-0 lg:divide-x divide-border/40">
          {stats.map(({ value, label }) => (
            <div class="py-10 px-6 text-center reveal">
              <div class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">{value}</div>
              <div class="mt-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground font-mono">
                {label}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- The Problem Section -->
    <section class="py-28 border-b border-border/40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-12 items-start">
          <div class="reveal">
            <p class="eyebrow mb-4">The manual entry problem</p>
            <h2 class="font-heading text-4xl md:text-5xl tracking-tight leading-[1.08]">
              Schedules live everywhere<br />except in your calendar.
            </h2>
          </div>
          <div class="md:pt-6 space-y-6 text-muted-foreground leading-relaxed reveal reveal-delay-1">
            <p>
              Class timetables arrive in multi-page PDFs. Conference itineraries are trapped in screenshot graphics. Shift rotas are pinned to break room notice boards.
            </p>
            <p>
              Typing every meeting, lab section, and speaker session line by line takes 45 minutes of painful copy-pasting. One typo leads to a missed flight or forgotten exam.
            </p>
            <p>
              QuickCalAI reads the source directly, identifies every date and time, and generates clean calendar entries that import anywhere without the busywork.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section id="how-it-works" class="py-28 border-b border-border/40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-16 reveal">
          <p class="eyebrow mb-3">Workflow</p>
          <h2 class="font-heading text-4xl md:text-5xl tracking-tight">Three steps from paper to calendar</h2>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          {steps.map(({ number, title, body }, i) => (
            <div class="surface-subtle rounded-xl p-8 card-minimal reveal" class:list={[`reveal-delay-${i + 1}`]}>
              <div class="text-4xl font-bold font-mono text-primary/40">{number}</div>
              <h3 class="mt-6 text-lg font-semibold">{title}</h3>
              <p class="mt-3 text-sm text-muted-foreground leading-relaxed">{body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Features Grid -->
    <section id="features" class="py-28 border-b border-border/40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-16 max-w-2xl reveal">
          <div class="rule-red mb-6"></div>
          <p class="eyebrow mb-3">Capabilities</p>
          <h2 class="font-heading text-4xl md:text-5xl tracking-tight">Rebuilt for speed and precision</h2>
          <p class="mt-4 text-muted-foreground leading-relaxed">
            Everything you need to convert, review, sync, and distribute schedules without friction.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {features.map(({ title, body, tag }, i) => (
            <div class="surface-subtle rounded-xl p-8 card-minimal reveal" class:list={[`reveal-delay-${(i % 3) + 1}`]}>
              <div class="inline-block text-[11px] font-mono font-semibold uppercase tracking-wider text-primary bg-primary/10 border border-primary/20 px-2.5 py-1 rounded-md mb-6">
                {tag}
              </div>
              <h3 class="text-base font-semibold">{title}</h3>
              <p class="mt-2 text-sm text-muted-foreground leading-relaxed">{body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- MCP & Agent Protocol Deep Dive -->
    <section id="mcp-demo" class="py-28 border-b border-border/40 bg-secondary/10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-12 gap-12 items-center">
          
          <div class="lg:col-span-5 reveal">
            <p class="eyebrow mb-4">Model Context Protocol</p>
            <h2 class="font-heading text-4xl md:text-5xl tracking-tight leading-[1.08]">
              Connect QuickCalAI directly to your agents.
            </h2>
            <p class="mt-6 text-muted-foreground leading-relaxed">
              QuickCalAI ships with an MCP server built right in. Claude, Cursor, and custom autonomous agents can read schedules, create events, inspect processing statuses, and revoke share links using standard tool calls.
            </p>
            <div class="mt-6 space-y-3 font-mono text-xs">
              <div class="flex items-center gap-2 text-foreground/80">
                <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                <span>qc_ API key authentication</span>
              </div>
              <div class="flex items-center gap-2 text-foreground/80">
                <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                <span>Stateless streamable HTTP JSON-RPC at POST /mcp</span>
              </div>
              <div class="flex items-center gap-2 text-foreground/80">
                <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                <span>9 specialized tools including create_events and get_status</span>
              </div>
            </div>
            <div class="mt-8">
              <a href="/signup" class="btn-solid">
                Get your API key
              </a>
            </div>
          </div>

          <div class="lg:col-span-7 reveal reveal-delay-2">
            <div class="rounded-xl border border-border/80 bg-black/90 p-6 font-mono text-xs shadow-xl">
              <div class="flex items-center justify-between pb-4 border-b border-border/40 text-muted-foreground">
                <span class="font-bold text-foreground">claude_desktop_config.json</span>
                <span class="text-[11px] text-primary">MCP Standard v1</span>
