---
import DashLayout from "../layouts/DashLayout.astro";
---

<DashLayout title="Settings — QuickCalAI" active="settings">
  <div class="mx-auto max-w-3xl px-4 py-8 space-y-8">
    <div>
      <h1 class="text-3xl font-bold mb-2">Settings</h1>
      <p class="text-muted-foreground">Manage contact info, API keys, and your subscription.</p>
    </div>

    <div id="settings-loading" class="text-sm text-muted-foreground">Loading…</div>

    <div id="settings-body" class="hidden space-y-8">
      <!-- Profile -->
      <section class="rounded-xl border border-border bg-card p-6">
        <h2 class="font-bold text-lg mb-4">Profile</h2>
        <div class="grid gap-4">
          <div>
            <label class="text-sm font-medium" for="set-name">Name</label>
            <input id="set-name" disabled class="mt-1 w-full px-4 bg-background border border-input rounded-lg h-10 text-muted-foreground" />
          </div>
          <div>
            <label class="text-sm font-medium" for="set-email">Email</label>
            <input id="set-email" disabled class="mt-1 w-full px-4 bg-background border border-input rounded-lg h-10 text-muted-foreground" />
          </div>
          <div>
            <label class="text-sm font-medium" for="set-phone">Phone Number</label>
            <input id="set-phone" type="tel" placeholder="+1 (555) 123-4567" class="mt-1 w-full px-4 bg-input border border-input rounded-lg h-10 focus:outline-none focus:border-primary" />
            <p class="mt-1 text-xs text-muted-foreground">Used to prefill SMS delivery. International format, e.g. +15551234567.</p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="text-sm font-medium" for="set-usecase">You make calendars from</label>
              <input id="set-usecase" disabled class="mt-1 w-full px-4 bg-background border border-input rounded-lg h-10 text-muted-foreground" />
            </div>
            <div>
              <label class="text-sm font-medium" for="set-calendar">Your calendar app</label>
              <input id="set-calendar" disabled class="mt-1 w-full px-4 bg-background border border-input rounded-lg h-10 text-muted-foreground" />
            </div>
          </div>
          <div>
            <button id="save-profile" class="bg-primary hover:bg-primary/90 text-primary-foreground rounded-lg px-5 py-2.5 text-sm font-bold">Save</button>
            <span id="profile-status" class="ml-3 text-sm"></span>
          </div>
        </div>
      </section>

      <!-- Subscription -->
      <section id="subscription" class="rounded-xl border border-border bg-card p-6">
        <h2 class="font-bold text-lg mb-2">Subscription</h2>
        <p id="sub-status" class="text-sm text-muted-foreground mb-4">Checking…</p>
        <div class="flex flex-wrap gap-3">
          <button id="btn-upgrade" class="hidden bg-primary hover:bg-primary/90 text-primary-foreground rounded-lg px-5 py-2.5 text-sm font-bold">Upgrade to Premium</button>
          <button id="btn-upgrade-annual" class="hidden border border-input hover:bg-accent hover:text-accent-foreground rounded-lg px-5 py-2.5 text-sm font-bold">Upgrade Annual</button>
          <button id="btn-portal" class="hidden border border-input hover:bg-accent hover:text-accent-foreground rounded-lg px-5 py-2.5 text-sm font-bold">Manage Billing</button>
          <button id="btn-cancel" class="hidden border border-danger/40 text-danger hover:bg-danger/10 rounded-lg px-5 py-2.5 text-sm font-bold">Cancel Subscription</button>
        </div>
        <p id="sub-error" class="hidden mt-3 text-sm text-danger"></p>
      </section>

      <!-- API keys -->
      <section class="rounded-xl border border-border bg-card p-6">
        <h2 class="font-bold text-lg mb-2">API Keys</h2>
        <p class="text-sm text-muted-foreground mb-4">Let AI agents and scripts act on your behalf with <code class="text-foreground">Authorization: Bearer qc_…</code>. Keys are shown once.</p>
        <div class="flex gap-2 mb-4">
          <input id="key-name" placeholder="e.g. claude-agent" class="flex-1 px-4 bg-input border border-input rounded-lg h-10 text-sm focus:outline-none focus:border-primary" />
          <button id="btn-create-key" class="bg-primary hover:bg-primary/90 text-primary-foreground rounded-lg px-5 text-sm font-bold">Create</button>
        </div>
        <div id="new-key" class="hidden mb-4 rounded-lg border border-success/30 bg-success/10 p-4">
          <p class="text-sm font-bold text-success mb-2">Copy this key now — it won't be shown again:</p>
          <div class="flex items-center gap-2 flex-wrap">
            <code id="new-key-value" class="flex-1 min-w-40 break-all text-sm select-all"></code>
            <button id="btn-copy-key" class="shrink-0 rounded-lg border border-input bg-background hover:bg-accent hover:text-accent-foreground px-3 py-1.5 text-xs font-bold transition-colors">Copy key</button>
          </div>
        </div>
        <div id="keys-list" class="space-y-2"></div>
      </section>

      <!-- Developer: agent integrations -->
      <section class="rounded-xl border border-border bg-card p-6">
        <h2 class="font-bold text-lg mb-2">Agents &amp; integrations</h2>
        <p class="text-sm text-muted-foreground mb-4">Everything an AI agent (or a calendar app) needs to work with your account.</p>

        <div class="space-y-2">
          <h3 class="text-sm font-semibold">Calendar feed — subscribe once, see everything</h3>
          <p class="text-xs text-muted-foreground">Every event you own, always current. Add by URL in Google Calendar, or switch to <code class="text-foreground">webcal://</code> for Apple Calendar.</p>
          <div class="flex items-center gap-2 flex-wrap">
            <code id="feed-url" class="flex-1 min-w-40 break-all text-xs select-all bg-input border border-input rounded-lg px-3 py-2"></code>
            <button id="btn-copy-feed" class="shrink-0 rounded-lg border border-input bg-background hover:bg-accent hover:text-accent-foreground px-3 py-1.5 text-xs font-bold transition-colors">Copy URL</button>
            <button id="btn-rotate-feed" class="shrink-0 rounded-lg border border-danger/40 text-danger hover:bg-danger/10 px-3 py-1.5 text-xs font-bold transition-colors">Rotate token</button>
          </div>
        </div>

        <div class="mt-5 space-y-2">
          <h3 class="text-sm font-semibold">Webhook signing secret</h3>
          <p class="text-xs text-muted-foreground">For <code class="text-foreground">callbackUrl</code> webhooks: verify the <code class="text-foreground">X-QuickCal-Signature</code> header (<code class="text-foreground">t=&lt;unix-seconds&gt;,v1=&lt;hex&gt;</code>) with HMAC-SHA256 over <code class="text-foreground">ts + "." + body</code> using this secret.</p>
          <div class="flex items-center gap-2 flex-wrap">
            <code id="webhook-secret" class="flex-1 min-w-40 break-all text-xs select-all bg-input border border-input rounded-lg px-3 py-2"></code>
            <button id="btn-copy-secret" class="shrink-0 rounded-lg border border-input bg-background hover:bg-accent hover:text-accent-foreground px-3 py-1.5 text-xs font-bold transition-colors">Copy secret</button>
          </div>
        </div>

        <div class="mt-5 space-y-2">
          <h3 class="text-sm font-semibold">MCP server</h3>
          <p class="text-xs text-muted-foreground">Use QuickCalAI from any MCP client (Claude, Cursor, …) — auth with your <code class="text-foreground">qc_…</code> API key:</p>
          <code id="mcp-url" class="block text-xs break-all bg-input border border-input rounded-lg px-3 py-2"></code>
        </div>
      </section>
    </div>
  </div>
</DashLayout>

<script>
  import { authClient } from "../lib/auth-client";
  import { api, ApiError } from "../lib/api";
  import { escapeHtml } from "../lib/html";

  function toast(message: string, ok = true) {
    const el = document.createElement("div");
    el.textContent = message;
    el.className = `fixed bottom-6 left-1/2 -translate-x-1/2 z-50 px-4 py-2.5 rounded-xl text-sm font-semibold shadow-xl ${ok ? "bg-success text-background" : "bg-danger text-white"}`;
    document.body.appendChild(el);
    setTimeout(() => el.remove(), 3500);
  }

  function showError(message: string) {
    const el = document.getElementById("sub-error")!;
    el.textContent = message;
    el.classList.remove("hidden");
  }

  const USE_CASE_LABELS: Record<string, string> = {
    class: "Class schedule",
    work: "Work shifts & rosters",
    conference: "Conference agendas",
    events: "Events & flyers",
    other: "Something else",
  };
  const CALENDAR_APP_LABELS: Record<string, string> = {
    google: "Google Calendar",
    apple: "Apple Calendar",
    outlook: "Outlook",
    other: "Another app",
  };

  async function init() {
    try {
      const { data: session } = await authClient.getSession();
      if (!session?.user) { window.location.href = "/login"; return; }

      const me = await api.me();
      (document.getElementById("set-name") as HTMLInputElement).value = me.name || "";
      (document.getElementById("set-email") as HTMLInputElement).value = me.email || "";
      (document.getElementById("set-phone") as HTMLInputElement).value = me.phoneNumber || "";
      (document.getElementById("set-usecase") as HTMLInputElement).value =
        (me.useCase && USE_CASE_LABELS[me.useCase]) || "Not set yet";
      (document.getElementById("set-calendar") as HTMLInputElement).value =
        (me.calendarApp && CALENDAR_APP_LABELS[me.calendarApp]) || "Not set yet";

      document.getElementById("save-profile")!.addEventListener("click", async () => {
        const status = document.getElementById("profile-status")!;
        try {
          const phone = (document.getElementById("set-phone") as HTMLInputElement).value.trim();
          await api.updateMe({ phoneNumber: phone, isOnboarded: true });
          status.textContent = "Saved.";
          status.className = "ml-3 text-sm text-success";
        } catch (err) {
          status.textContent = err instanceof Error ? err.message : "Save failed.";
          status.className = "ml-3 text-sm text-danger";
        }
      });

      // Subscription
      const subStatus = document.getElementById("sub-status")!;
      const btnUpgrade = document.getElementById("btn-upgrade")!;
      const btnUpgradeAnnual = document.getElementById("btn-upgrade-annual")!;
      const btnPortal = document.getElementById("btn-portal")!;
      const btnCancel = document.getElementById("btn-cancel")!;
      if (me.isPremium) {
        subStatus.innerHTML = '<span class="inline-block bg-primary text-primary-foreground px-3 py-1 rounded-full text-xs font-bold">PREMIUM</span> <span class="ml-2">AI uploads, email & SMS delivery enabled.</span>';
        btnPortal.classList.remove("hidden");
        btnCancel.classList.remove("hidden");
      } else {
        subStatus.textContent = "Free plan — AI uploads and delivery require Premium.";
        btnUpgrade.classList.remove("hidden");
        btnUpgradeAnnual.classList.remove("hidden");
      }

      const here = window.location.origin;
      btnUpgrade.addEventListener("click", async () => {
        try {
          await authClient.subscription.upgrade({
            plan: "premium",
            successUrl: `${here}/settings?upgraded=1`,
            cancelUrl: `${here}/settings?canceled=1`,
          });
        } catch (err) {
          showError(err instanceof Error ? err.message : "Upgrade failed.");
        }
      });
      btnUpgradeAnnual.addEventListener("click", async () => {
        try {
          await authClient.subscription.upgrade({
            plan: "premium",
            annual: true,
            successUrl: `${here}/settings?upgraded=1`,
            cancelUrl: `${here}/settings?canceled=1`,
          });
        } catch (err) {
          showError(err instanceof Error ? err.message : "Upgrade failed.");
        }
      });
      btnPortal.addEventListener("click", async () => {
        try {
          await authClient.subscription.billingPortal({ returnUrl: `${here}/settings` });
        } catch (err) {
          showError(err instanceof Error ? err.message : "Could not open billing portal.");
        }
      });
      btnCancel.addEventListener("click", async () => {
        if (!confirm("Cancel your premium subscription?")) return;
        try {
          await authClient.subscription.cancel({ returnUrl: `${here}/settings` });
        } catch (err) {
          showError(err instanceof Error ? err.message : "Cancel failed.");
        }
      });
      const params = new URLSearchParams(window.location.search);
      if (params.get("upgraded")) subStatus.textContent = "Subscription active — welcome to Premium!";
      if (params.get("canceled")) subStatus.textContent = "Checkout canceled — no changes made.";

      // API keys
      async function refreshKeys() {
        const { keys } = await api.listKeys();
        const list = document.getElementById("keys-list")!;
        list.innerHTML = keys.length === 0
          ? '<p class="text-sm text-muted-foreground">No API keys yet.</p>'
          : keys.map((k) => `
            <div class="flex items-center justify-between gap-3 rounded-lg border border-border bg-background px-4 py-3">
              <div class="min-w-0">
                <p class="text-sm font-semibold truncate">${escapeHtml(k.name)}</p>
                <p class="text-xs text-muted-foreground font-mono">${escapeHtml(k.keyPrefix)}… ${k.lastUsedAt ? `· last used ${new Date(k.lastUsedAt).toLocaleDateString()}` : "· never used"}</p>
              </div>
              <button data-revoke="${k.id}" class="shrink-0 text-xs font-bold text-danger hover:text-danger/80 border border-danger/40 hover:bg-danger/10 rounded-lg px-3 py-1.5">Revoke</button>
            </div>`).join("");
        for (const btn of list.querySelectorAll("[data-revoke]")) {
          btn.addEventListener("click", async () => {
            if (!confirm("Revoke this API key?")) return;
            await api.deleteKey(btn.getAttribute("data-revoke")!);
            void refreshKeys();
          });
        }
      }

      document.getElementById("btn-create-key")!.addEventListener("click", async () => {
        const nameInput = document.getElementById("key-name") as HTMLInputElement;
        const name = nameInput.value.trim();
        if (!name) return;
        try {
          const created = await api.createKey({ name });
          document.getElementById("new-key-value")!.textContent = created.key;
          document.getElementById("btn-copy-key")!.textContent = "Copy key";
          document.getElementById("new-key")!.classList.remove("hidden");
          nameInput.value = "";
          void refreshKeys();
        } catch (err) {
          showError(err instanceof Error ? err.message : "Could not create key.");
        }
      });

      // One-click copy for the freshly created key (shown once).
      document.getElementById("btn-copy-key")!.addEventListener("click", async () => {
        const btn = document.getElementById("btn-copy-key") as HTMLButtonElement;
        const value = document.getElementById("new-key-value")!.textContent ?? "";
        if (!value) return;
        try {
          await navigator.clipboard.writeText(value);
          btn.textContent = "Copied!";
        } catch {
          // Clipboard API unavailable (e.g. insecure context) — select the
          // key text so a manual ⌘C / Ctrl+C is one keystroke away.
          const range = document.createRange();
          range.selectNodeContents(document.getElementById("new-key-value")!);
          const sel = window.getSelection();
          sel?.removeAllRanges();
          sel?.addRange(range);
          btn.textContent = "Press Ctrl/⌘ + C";
        }
        setTimeout(() => { btn.textContent = "Copy key"; }, 2500);
      });

      await refreshKeys();

      // Agents & integrations
      const serverOrigin = api.serverUrl();
      const feedUrl = document.getElementById("feed-url")!;
      const mcpUrl = document.getElementById("mcp-url")!;
      const webhookSecret = document.getElementById("webhook-secret")!;
      feedUrl.textContent = me.calendarFeedPath ? `${serverOrigin}${me.calendarFeedPath}` : "";
      mcpUrl.textContent = `${serverOrigin}/mcp`;
      webhookSecret.textContent = me.webhookSecret;

      document.getElementById("btn-copy-feed")!.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(feedUrl.textContent || "");
          toast("Calendar feed URL copied.");
        } catch { /* clipboard unavailable */ }
      });
      document.getElementById("btn-copy-secret")!.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(webhookSecret.textContent || "");
          toast("Webhook secret copied.");
        } catch { /* clipboard unavailable */ }
      });
      document.getElementById("btn-rotate-feed")!.addEventListener("click", async () => {
        if (!confirm("Rotate the calendar feed token? Old subscription URLs stop working immediately.")) return;
        try {
          const res = await api.rotateCalendarFeed();
          feedUrl.textContent = `${serverOrigin}${res.feedPath}`;
          toast("Feed token rotated — re-add the URL in your calendar app.");
        } catch (err) {
          showError(err instanceof Error ? err.message : "Could not rotate the feed.");
        }
      });

      document.getElementById("settings-loading")!.classList.add("hidden");
      document.getElementById("settings-body")!.classList.remove("hidden");
    } catch (err) {
      if (err instanceof ApiError && err.status === 401) { window.location.href = "/login"; return; }
      document.getElementById("settings-loading")!.textContent =
        err instanceof Error ? err.message : "Failed to load settings.";
    }
  }

  init();
</script>
