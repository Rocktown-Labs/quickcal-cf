{
  "name": "quickcal-cf",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.6.6",
      "@types/node": "^26.4.1",
      "varlock": "1.18.0",
      "@cloudflare/workers-types": "^5.20260906.1",
      "better-auth": "1.7.14",
      "evlog": "^2.28.1",
      "tailwindcss": "^4.3.3",
      "@better-auth/expo": "1.7.14",
      "drizzle-orm": "1.0.0-rc.4"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native --",
    "dev:web": "turbo run dev -F web",
    "test": "bun test ./packages/db ./apps/server ./packages/auth ./scripts",
    "test:all": "turbo run test",
    "check": "oxlint apps/server/src apps/web/src packages && oxfmt --check apps/server/src apps/web/src packages",
    "db:generate": "turbo run db:generate -F @quickcal-cf/db --",
    "migrate:clerk-users": "bun scripts/migrate-clerk-users.ts",
    "email:announcement": "bun scripts/send-announcement.ts",
    "deploy": "turbo run deploy -F @quickcal-cf/infra --",
    "destroy": "turbo run destroy -F @quickcal-cf/infra --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/"
  },
  "packageManager": "bun@1.3.3",
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@quickcal-cf/config": "workspace:*",
    "@types/node": "catalog:",
    "bun-types": "^1.4.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "varlock": "catalog:"
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
